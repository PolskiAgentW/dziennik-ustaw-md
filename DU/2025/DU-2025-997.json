{
 "eli": "DU/2025/997",
 "title": "Rozporządzenie Prezesa Rady Ministrów z dnia 25 lipca 2025 r. w sprawie szczegółowego zakresu działania Ministra Finansów i Gospodarki",
 "converter": "eli2md 0.6.4",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/DU/2025/997/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "ROZPORZĄDZENIE"
  },
  {
   "type": "text",
   "text": "PREZESA RADY MINISTRÓW"
  },
  {
   "type": "text",
   "text": "z dnia 25 lipca 2025 r."
  },
  {
   "type": "text",
   "text": "w sprawie szczegółowego zakresu działania Ministra Finansów i Gospodarki"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 33 ust. 1 i 1a ustawy z dnia 8 sierpnia 1996 r. o Radzie Ministrów (Dz. U. z 2025 r. poz. 780) zarządza się, co następuje:"
  },
  {
   "type": "par",
   "num": "1",
   "path": "par_1",
   "text": "",
   "children": [
    {
     "type": "ust",
     "num": "1",
     "path": "par_1/ust_1",
     "text": "Rozporządzenie określa szczegółowy zakres działania Ministra Finansów i Gospodarki, zwanego dalej „ministrem”.",
     "children": []
    },
    {
     "type": "ust",
     "num": "2",
     "path": "par_1/ust_2",
     "text": "Minister kieruje następującymi działami administracji rządowej:",
     "children": [
      {
       "type": "pkt",
       "num": "1",
       "path": "par_1/ust_2/pkt_1",
       "text": "budownictwo, planowanie i zagospodarowanie przestrzenne oraz mieszkalnictwo;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "2",
       "path": "par_1/ust_2/pkt_2",
       "text": "budżet;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "3",
       "path": "par_1/ust_2/pkt_3",
       "text": "finanse publiczne;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "4",
       "path": "par_1/ust_2/pkt_4",
       "text": "gospodarka;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "5",
       "path": "par_1/ust_2/pkt_5",
       "text": "instytucje finansowe.",
       "children": []
      }
     ]
    },
    {
     "type": "ust",
     "num": "3",
     "path": "par_1/ust_3",
     "text": "Minister jest dysponentem części 18, 19 i 20 budżetu państwa.",
     "children": []
    },
    {
     "type": "ust",
     "num": "4",
     "path": "par_1/ust_4",
     "text": "Obsługę ministra zapewnia:",
     "children": [
      {
       "type": "pkt",
       "num": "1",
       "path": "par_1/ust_4/pkt_1",
       "text": "Ministerstwo Rozwoju i Technologii w zakresie działów administracji rządowej:",
       "children": [
        {
         "type": "lit",
         "num": "a",
         "path": "par_1/ust_4/pkt_1/lit_a",
         "text": "budownictwo, planowanie i zagospodarowanie przestrzenne oraz mieszkalnictwo,",
         "children": []
        },
        {
         "type": "lit",
         "num": "b",
         "path": "par_1/ust_4/pkt_1/lit_b",
         "text": "gospodarka;",
         "children": []
        }
       ]
      },
      {
       "type": "pkt",
       "num": "2",
       "path": "par_1/ust_4/pkt_2",
       "text": "Ministerstwo Finansów w zakresie działów administracji rządowej:",
       "children": [
        {
         "type": "lit",
         "num": "a",
         "path": "par_1/ust_4/pkt_2/lit_a",
         "text": "budżet,",
         "children": []
        },
        {
         "type": "lit",
         "num": "b",
         "path": "par_1/ust_4/pkt_2/lit_b",
         "text": "finanse publiczne,",
         "children": []
        },
        {
         "type": "lit",
         "num": "c",
         "path": "par_1/ust_4/pkt_2/lit_c",
         "text": "instytucje finansowe.",
         "children": []
        }
       ]
      }
     ]
    },
    {
     "type": "ust",
     "num": "5",
     "path": "par_1/ust_5",
     "text": "Organy podległe ministrowi lub przez niego nadzorowane określa załącznik do rozporządzenia.",
     "children": []
    }
   ]
  },
  {
   "type": "par",
   "num": "2",
   "path": "par_2",
   "text": "Rozporządzenie wchodzi w życie z dniem ogłoszenia, z mocą od dnia 24 lipca 2025 r.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezes Rady Ministrów: D. Tusk"
  }
 ],
 "annexes": [
  {
   "heading": "Załącznik do rozporządzenia Prezesa Rady Ministrów z dnia 25 lipca 2025 r. (Dz. U. poz. 997)",
