 "body": [
  {
   "type": "text",
   "text": "ROZPORZĄDZENIE"
  },
  {
   "type": "text",
   "text": "MINISTRA SPRAW WEWNĘTRZNYCH I ADMINISTRACJI[^1]"
  },
  {
   "type": "text",
   "text": "z dnia 10 lipca 2025 r."
  },
  {
   "type": "text",
   "text": "w sprawie uzbrojenia Straży Granicznej"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 75 ust. 2 ustawy z dnia 12 października 1990 r. o Straży Granicznej (Dz. U. z 2025 r. poz. 914) zarządza się, co następuje:"
  },
  {
   "type": "par",
   "num": "1",
   "path": "par_1",
   "text": "Na uzbrojenie Straży Granicznej składają się:",
   "children": [
    {
     "type": "pkt",
     "num": "1",
     "path": "par_1/pkt_1",
     "text": "broń palna:",
     "children": [
      {
       "type": "lit",
       "num": "a",
       "path": "par_1/pkt_1/lit_a",
       "text": "pistolety,",
       "children": []
      },
      {
       "type": "lit",
       "num": "b",
       "path": "par_1/pkt_1/lit_b",
       "text": "rewolwery,",
       "children": []
      },
      {
       "type": "lit",
       "num": "c",
       "path": "par_1/pkt_1/lit_c",
       "text": "broń gładkolufowa,",
       "children": []
      },
      {
       "type": "lit",
       "num": "d",
       "path": "par_1/pkt_1/lit_d",
       "text": "pistolety maszynowe,",
       "children": []
      },
      {
       "type": "lit",
       "num": "e",
       "path": "par_1/pkt_1/lit_e",
       "text": "karabinki,",
       "children": []
      },
      {
       "type": "lit",
       "num": "f",
       "path": "par_1/pkt_1/lit_f",
       "text": "karabiny,",
       "children": []
      },
      {
       "type": "lit",
       "num": "g",
       "path": "par_1/pkt_1/lit_g",
       "text": "karabiny maszynowe,",
       "children": []
      },
      {
       "type": "lit",
       "num": "h",
       "path": "par_1/pkt_1/lit_h",
       "text": "granatniki;",
       "children": []
      }
     ]
    },
    {
     "type": "pkt",
     "num": "2",
     "path": "par_1/pkt_2",
     "text": "środki przymusu bezpośredniego:",
     "children": [
      {
       "type": "lit",
       "num": "a",
       "path": "par_1/pkt_2/lit_a",
       "text": "kajdanki,",
       "children": []
      },
      {
       "type": "lit",
       "num": "b",
       "path": "par_1/pkt_2/lit_b",
       "text": "kaftany bezpieczeństwa,",
       "children": []
      },
      {
       "type": "lit",
       "num": "c",
       "path": "par_1/pkt_2/lit_c",
       "text": "pasy obezwładniające,",
       "children": []
      },
      {
       "type": "lit",
       "num": "d",
       "path": "par_1/pkt_2/lit_d",
       "text": "siatki obezwładniające i inne podobne środki służące do obezwładniania,",
       "children": []
      },
      {
       "type": "lit",
       "num": "e",
       "path": "par_1/pkt_2/lit_e",
       "text": "kaski zabezpieczające,",
       "children": []
      },
      {
       "type": "lit",
       "num": "f",
       "path": "par_1/pkt_2/lit_f",
       "text": "pałki służbowe,",
       "children": []
      },
      {
       "type": "lit",
       "num": "g",
       "path": "par_1/pkt_2/lit_g",
       "text": "wodne środki obezwładniające,",
       "children": []
      },
      {
       "type": "lit",
       "num": "h",
       "path": "par_1/pkt_2/lit_h",
       "text": "psy służbowe,",
       "children": []
      },
      {
       "type": "lit",
       "num": "i",
       "path": "par_1/pkt_2/lit_i",
       "text": "konie służbowe,",
       "children": []
      },
      {
       "type": "lit",
       "num": "j",
       "path": "par_1/pkt_2/lit_j",
       "text": "pociski niepenetracyjne,",
       "children": []
      },
      {
       "type": "lit",
       "num": "k",
       "path": "par_1/pkt_2/lit_k",
       "text": "chemiczne środki obezwładniające w postaci:",
       "children": [
        {
         "type": "tir",
         "num": "1",
         "path": "par_1/pkt_2/lit_k/tir_1",
         "text": "ręcznych miotaczy substancji obezwładniających,",
         "children": []
        },
        {
         "type": "tir",
         "num": "2",
         "path": "par_1/pkt_2/lit_k/tir_2",
         "text": "plecakowych miotaczy substancji obezwładniających,",
         "children": []
        },
        {
         "type": "tir",
         "num": "3",
         "path": "par_1/pkt_2/lit_k/tir_3",
         "text": "granatów łzawiących,",
         "children": []
        },
        {
         "type": "tir",
         "num": "4",
         "path": "par_1/pkt_2/lit_k/tir_4",
         "text": "innych urządzeń przeznaczonych do miotania środków obezwładniających,",
         "children": []
        }
       ]
      },
      {
       "type": "lit",
       "num": "l",
       "path": "par_1/pkt_2/lit_l",
       "text": "przedmioty przeznaczone do obezwładniania osób za pomocą energii elektrycznej,",
       "children": []
      },
      {
       "type": "lit",
       "num": "m",
       "path": "par_1/pkt_2/lit_m",
       "text": "kolczatki drogowe i inne środki służące do zatrzymywania oraz unieruchamiania pojazdów mechanicznych,",
       "children": []
      },
      {
       "type": "lit",
       "num": "n",
       "path": "par_1/pkt_2/lit_n",
       "text": "pojazdy służbowe,",
       "children": []
      },
      {
       "type": "lit",
       "num": "o",
       "path": "par_1/pkt_2/lit_o",
       "text": "środki przeznaczone do pokonywania zamknięć budowlanych i innych przeszkód, w tym materiały wybuchowe,",
       "children": []
      },
      {
       "type": "lit",
       "num": "p",
       "path": "par_1/pkt_2/lit_p",
       "text": "środki pirotechniczne o właściwościach ogłuszających lub olśniewających,",
       "children": []
      },
      {
       "type": "lit",
       "num": "q",
       "path": "par_1/pkt_2/lit_q",
       "text": "środki i urządzenia przeznaczone do zniszczenia albo unieruchomienia bezzałogowego statku powietrznego albo przejęcia kontroli nad jego lotem, o których mowa w art. 33a ust. 2 ustawy z dnia 24 maja 2013 r. o środkach przymusu bezpośredniego i broni palnej (Dz. U. z 2025 r. poz. 555 i 820);",
       "children": []
      }
     ]
    },
    {
     "type": "pkt",
     "num": "3",
     "path": "par_1/pkt_3",
     "text": "broń pneumatyczna przeznaczona do miotania pocisków niepenetracyjnych lub innych przedmiotów;",
     "children": []
    },
    {
     "type": "pkt",
     "num": "4",
     "path": "par_1/pkt_4",
     "text": "wyrzutnie siatek obezwładniających i innych podobnych środków służących do obezwładniania;",
     "children": []
    },
    {
     "type": "pkt",
     "num": "5",
     "path": "par_1/pkt_5",
     "text": "urządzenia przeznaczone do miotania wodnych środków obezwładniających;",
     "children": []
    },
    {
     "type": "pkt",
     "num": "6",
     "path": "par_1/pkt_6",
     "text": "urządzenia przeznaczone do miotania pocisków pirotechnicznych twardych i wodnych;",
     "children": []
    },
    {
     "type": "pkt",
     "num": "7",
     "path": "par_1/pkt_7",
     "text": "amunicja do broni, o której mowa w pkt 1;",
     "children": []
    },
    {
     "type": "pkt",
     "num": "8",
     "path": "par_1/pkt_8",
     "text": "kartridże do przedmiotów, o których mowa w pkt 2 lit. l;",
     "children": []
    },
    {
     "type": "pkt",
     "num": "9",
     "path": "par_1/pkt_9",
     "text": "naboje i kartridże do wyrzutni siatek obezwładniających i innych podobnych środków, o których mowa w pkt 4;",
     "children": []
    },
    {
     "type": "pkt",
     "num": "10",
     "path": "par_1/pkt_10",
     "text": "ładunki miotające do urządzeń, o których mowa w pkt 6.",
     "children": []
    }
   ]
  },
  {
   "type": "par",
   "num": "2",
   "path": "par_2",
   "text": "Traci moc rozporządzenie Ministra Spraw Wewnętrznych z dnia 9 maja 2014 r. w sprawie uzbrojenia Straży Granicznej (Dz. U. z 2022 r. poz. 156).",
   "children": []
  },
  {
   "type": "par",
   "num": "3",
   "path": "par_3",
   "text": "Rozporządzenie wchodzi w życie po upływie 14 dni od dnia ogłoszenia.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Minister Spraw Wewnętrznych i Administracji: wz. C. Mroczek"
  }
 ],
 "annexes": [],
 "footnotes": {
  "1": "Minister Spraw Wewnętrznych i Administracji kieruje działem administracji rządowej – sprawy wewnętrzne, na podstawie § 1 ust. 2 pkt 2 rozporządzenia Prezesa Rady Ministrów z dnia 16 maja 2024 r. w sprawie szczegółowego zakresu działania Ministra Spraw Wewnętrznych i Administracji (Dz. U. poz. 738)."
 }
